# =============================================================================
# OpenFinance Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://openfinance:password@db:5432/openfinance_production
DB_HOST=db
DB_PORT=5432
DB_NAME=openfinance_production
DB_USERNAME=openfinance
DB_PASSWORD=password

# -----------------------------------------------------------------------------
# Rails Configuration
# -----------------------------------------------------------------------------
RAILS_ENV=production
RAILS_MASTER_KEY=your_master_key_here_32_chars_minimum
SECRET_KEY_BASE=your_secret_key_base_here_64_chars_minimum

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=your_jwt_secret_here_32_chars_minimum
JWT_EXPIRATION_HOURS=24

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
SIDEKIQ_REDIS_URL=redis://redis:6379/1

# -----------------------------------------------------------------------------
# Plaid Integration (Optional - for bank connectivity)
# -----------------------------------------------------------------------------
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENVIRONMENT=sandbox
# Options: sandbox (testing), development (development), production (live)
PLAID_WEBHOOK_URL=https://yourdomain.com/api/plaid/webhook

# -----------------------------------------------------------------------------
# Email Configuration (Optional - for notifications)
# -----------------------------------------------------------------------------
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_DOMAIN=yourdomain.com
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS=true

# Default sender email
FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
API_HOST=api
WEB_HOST=web

# -----------------------------------------------------------------------------
# File Storage (Optional - for receipts, exports)
# -----------------------------------------------------------------------------
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET=openfinance-uploads

# Or use local storage
STORAGE_TYPE=local
UPLOAD_PATH=/app/storage

# -----------------------------------------------------------------------------
# External Services (Optional)
# -----------------------------------------------------------------------------
# Sentry for error tracking
SENTRY_DSN=your_sentry_dsn_here

# New Relic for monitoring
NEW_RELIC_LICENSE_KEY=your_new_relic_key

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Session configuration
SESSION_TIMEOUT_HOURS=72
REMEMBER_ME_DURATION_DAYS=30

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_PLAID=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_BACKGROUND_JOBS=true
ENABLE_API_DOCS=true

# -----------------------------------------------------------------------------
# Development/Debugging
# -----------------------------------------------------------------------------
# Set to true for development
ENABLE_GRAPHQL_PLAYGROUND=false
LOG_LEVEL=info
DEBUG_MODE=false

# Sample data for development
SEED_SAMPLE_DATA=false

# -----------------------------------------------------------------------------
# Container Configuration
# -----------------------------------------------------------------------------
# Rails container
API_PORT=3001
API_WORKERS=2

# Web container  
WEB_PORT=3000

# Database container
POSTGRES_USER=openfinance
POSTGRES_PASSWORD=password
POSTGRES_DB=openfinance_production

# Redis container
REDIS_PORT=6379