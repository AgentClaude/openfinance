<% @header_subtitle = "Budget alert for #{Date.current.strftime('%B %Y')}" %>

<h2 style="font-size: 18px; color: #18181b; margin: 0 0 16px;">
  <% if @percentage >= 100 %>
    🔴 Over Budget: <%= @category_name %>
  <% else %>
    ⚠️ Budget Warning: <%= @category_name %>
  <% end %>
</h2>

<div style="text-align: center; margin: 24px 0;">
  <div style="font-size: 48px; font-weight: 700; color: <%= @percentage >= 100 ? '#dc2626' : '#ca8a04' %>;">
    <%= @percentage %>%
  </div>
  <div style="font-size: 14px; color: #71717a;">of budget used</div>
</div>

<div style="background: #fafafa; border: 1px solid #e4e4e7; border-radius: 8px; padding: 20px; margin: 20px 0;">
  <table style="width: 100%;">
    <tr>
      <td style="padding: 8px 0; border: none; color: #71717a; font-size: 14px;">Budgeted</td>
      <td style="padding: 8px 0; border: none; text-align: right; font-size: 14px; font-weight: 500;">$<%= '%.2f' % @budgeted %></td>
    </tr>
    <tr>
      <td style="padding: 8px 0; border: none; color: #71717a; font-size: 14px;">Spent</td>
      <td style="padding: 8px 0; border: none; text-align: right; font-size: 14px; font-weight: 600; color: #dc2626;">$<%= '%.2f' % @spent %></td>
    </tr>
    <% if @percentage >= 100 %>
      <tr>
        <td style="padding: 8px 0; border-top: 1px solid #e4e4e7; color: #71717a; font-size: 14px;">Over by</td>
        <td style="padding: 8px 0; border-top: 1px solid #e4e4e7; text-align: right; font-size: 14px; font-weight: 700; color: #dc2626;">$<%= '%.2f' % @over_amount %></td>
      </tr>
    <% else %>
      <tr>
        <td style="padding: 8px 0; border-top: 1px solid #e4e4e7; color: #71717a; font-size: 14px;">Remaining</td>
        <td style="padding: 8px 0; border-top: 1px solid #e4e4e7; text-align: right; font-size: 14px; font-weight: 500; color: #16a34a;">$<%= '%.2f' % (@budgeted - @spent) %></td>
      </tr>
    <% end %>
  </table>
</div>

<!-- Progress bar -->
<div style="margin: 16px 0;">
  <div class="progress-bg">
    <div class="progress-bar" style="width: <%= [[@percentage, 100].min, 0].max %>%; background: <%= @percentage >= 100 ? '#dc2626' : '#ca8a04' %>;"></div>
  </div>
</div>

<div style="text-align: center; margin-top: 24px;">
  <a href="#" class="btn">View Budget →</a>
</div>
