<div style="max-width: 500px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
  <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 24px;">
    <h2 style="margin: 0 0 8px; color: #991b1b;">💰 Large Transaction Detected</h2>
    <p style="margin: 0; color: #4b5563; font-size: 15px;">
      A transaction of <strong><%= @amount %></strong> was recorded.
    </p>
    <p style="margin: 8px 0 0; color: #6b7280; font-size: 14px;">
      Check your transactions page for details.
    </p>
  </div>
  <p style="text-align: center; color: #9ca3af; font-size: 12px; margin-top: 16px;">OpenFinance</p>
</div>
