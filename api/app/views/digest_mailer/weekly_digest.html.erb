<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; margin: 0; padding: 0; background: #f4f4f5; color: #18181b; }
    .container { max-width: 600px; margin: 0 auto; background: #ffffff; }
    .header { background: linear-gradient(135deg, #4f46e5, #7c3aed); padding: 32px 24px; text-align: center; }
    .header h1 { color: #ffffff; margin: 0; font-size: 24px; font-weight: 600; }
    .header .period { color: #c7d2fe; font-size: 14px; margin-top: 4px; }
    .section { padding: 24px; border-bottom: 1px solid #e4e4e7; }
    .section-title { font-size: 16px; font-weight: 600; color: #3f3f46; margin: 0 0 16px 0; text-transform: uppercase; letter-spacing: 0.05em; }
    .stat-grid { display: flex; gap: 12px; flex-wrap: wrap; }
    .stat-card { flex: 1; min-width: 120px; background: #f9fafb; border-radius: 8px; padding: 16px; text-align: center; }
    .stat-value { font-size: 24px; font-weight: 700; color: #18181b; }
    .stat-value.green { color: #16a34a; }
    .stat-value.red { color: #dc2626; }
    .stat-label { font-size: 12px; color: #71717a; margin-top: 4px; }
    .stat-change { font-size: 11px; margin-top: 4px; }
    .stat-change.up { color: #dc2626; }
    .stat-change.down { color: #16a34a; }
    table { width: 100%; border-collapse: collapse; }
    table th { text-align: left; font-size: 11px; color: #71717a; text-transform: uppercase; padding: 8px 0; border-bottom: 1px solid #e4e4e7; }
    table td { padding: 10px 0; border-bottom: 1px solid #f4f4f5; font-size: 14px; }
    table td.amount { text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
    .progress-bar { height: 6px; background: #e4e4e7; border-radius: 3px; overflow: hidden; margin-top: 4px; }
    .progress-fill { height: 100%; border-radius: 3px; }
    .progress-fill.green { background: #16a34a; }
    .progress-fill.yellow { background: #eab308; }
    .progress-fill.red { background: #dc2626; }
    .badge { display: inline-block; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 9999px; }
    .badge.over { background: #fef2f2; color: #dc2626; }
    .badge.warning { background: #fffbeb; color: #d97706; }
    .footer { padding: 24px; text-align: center; color: #a1a1aa; font-size: 12px; }
    .footer a { color: #6366f1; }
    .empty { color: #a1a1aa; font-size: 13px; font-style: italic; }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <h1>📊 Weekly Digest</h1>
      <div class="period"><%= @period[:start].strftime('%B %d') %> – <%= @period[:end].strftime('%B %d, %Y') %></div>
    </div>

    <!-- Summary Stats -->
    <div class="section">
      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-value red">$<%= '%.2f' % (@spending[:total_cents] / 100.0) %></div>
          <div class="stat-label">Spent</div>
          <% if @spending[:change_pct] %>
            <div class="stat-change <%= @spending[:change_pct] > 0 ? 'up' : 'down' %>">
              <%= @spending[:change_pct] > 0 ? '↑' : '↓' %> <%= @spending[:change_pct].abs %>% vs last week
            </div>
          <% end %>
        </div>
        <div class="stat-card">
          <div class="stat-value green">$<%= '%.2f' % (@income[:total_cents] / 100.0) %></div>
          <div class="stat-label">Income</div>
        </div>
        <div class="stat-card">
          <div class="stat-value <%= @net[:positive] ? 'green' : 'red' %>">
            <%= @net[:positive] ? '+' : '-' %>$<%= '%.2f' % (@net[:cents].abs / 100.0) %>
          </div>
          <div class="stat-label">Net Cash Flow</div>
        </div>
      </div>
    </div>

    <!-- Top Spending Categories -->
    <% if @top_categories.any? %>
    <div class="section">
      <div class="section-title">Top Spending Categories</div>
      <table>
        <% @top_categories.each do |cat| %>
          <tr>
            <td><%= cat[:name] %></td>
            <td class="amount">$<%= '%.2f' % (cat[:total_cents] / 100.0) %></td>
          </tr>
        <% end %>
      </table>
    </div>
    <% end %>

    <!-- Budget Alerts -->
    <% if @budget_status.any? %>
    <div class="section">
      <div class="section-title">⚠️ Budget Alerts</div>
      <table>
        <% @budget_status.each do |item| %>
          <tr>
            <td>
              <%= item[:category] %>
              <span class="badge <%= item[:status] %>"><%= item[:percentage] %>%</span>
              <div class="progress-bar">
                <div class="progress-fill <%= item[:percentage] >= 100 ? 'red' : 'yellow' %>"
                     style="width: <%= [item[:percentage], 100].min %>%"></div>
              </div>
            </td>
            <td class="amount">$<%= '%.2f' % (item[:spent_cents] / 100.0) %> / $<%= '%.2f' % (item[:budgeted_cents] / 100.0) %></td>
          </tr>
        <% end %>
      </table>
    </div>
    <% end %>

    <!-- Large Transactions -->
    <% if @large_transactions.any? %>
    <div class="section">
      <div class="section-title">Large Transactions</div>
      <table>
        <% @large_transactions.each do |txn| %>
          <tr>
            <td>
              <%= txn[:description] %>
              <br><span style="font-size: 12px; color: #71717a;"><%= txn[:category] %> · <%= txn[:date].strftime('%b %d') %></span>
            </td>
            <td class="amount">$<%= '%.2f' % (txn[:amount_cents] / 100.0) %></td>
          </tr>
        <% end %>
      </table>
    </div>
    <% end %>

    <!-- Upcoming Bills -->
    <% if @upcoming_bills.any? %>
    <div class="section">
      <div class="section-title">📅 Upcoming Bills</div>
      <table>
        <% @upcoming_bills.each do |bill| %>
          <tr>
            <td><%= bill[:name] %> <span style="color: #71717a; font-size: 12px;">· due <%= bill[:due_date].strftime('%b %d') %></span></td>
            <td class="amount">$<%= '%.2f' % (bill[:amount_cents] / 100.0) %></td>
          </tr>
        <% end %>
      </table>
    </div>
    <% end %>

    <!-- Net Worth -->
    <div class="section">
      <div class="section-title">Net Worth</div>
      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-value" style="font-size: 18px; color: #16a34a;">$<%= number_with_delimiter('%.2f' % (@net_worth[:assets_cents] / 100.0)) %></div>
          <div class="stat-label">Assets</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" style="font-size: 18px; color: #dc2626;">$<%= number_with_delimiter('%.2f' % (@net_worth[:liabilities_cents] / 100.0)) %></div>
          <div class="stat-label">Liabilities</div>
        </div>
        <div class="stat-card">
          <div class="stat-value" style="font-size: 18px;">$<%= number_with_delimiter('%.2f' % (@net_worth[:net_cents] / 100.0)) %></div>
          <div class="stat-label">Net Worth</div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <p>You're receiving this because you have weekly digest enabled in your OpenFinance settings.</p>
      <p><a href="#">View Dashboard</a> · <a href="#">Manage Preferences</a></p>
    </div>
  </div>
</body>
</html>
