<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f4f4f7; margin: 0; padding: 0; color: #333; }
    .container { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 8px; overflow: hidden; }
    .header { background: linear-gradient(135deg, #10b981, #059669); padding: 32px 24px; text-align: center; }
    .header h1 { color: #fff; margin: 0; font-size: 24px; font-weight: 600; }
    .header p { color: rgba(255,255,255,0.85); margin: 8px 0 0; font-size: 14px; }
    .section { padding: 24px; border-bottom: 1px solid #eee; }
    .section:last-child { border-bottom: none; }
    .section-title { font-size: 16px; font-weight: 600; color: #111; margin: 0 0 16px; }
    .stat-grid { display: flex; gap: 16px; flex-wrap: wrap; }
    .stat-card { flex: 1; min-width: 120px; background: #f9fafb; border-radius: 8px; padding: 16px; text-align: center; }
    .stat-value { font-size: 24px; font-weight: 700; color: #111; }
    .stat-value.green { color: #059669; }
    .stat-value.red { color: #dc2626; }
    .stat-label { font-size: 12px; color: #6b7280; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
    table { width: 100%; border-collapse: collapse; }
    table td { padding: 10px 0; font-size: 14px; border-bottom: 1px solid #f3f4f6; }
    table td:last-child { text-align: right; font-weight: 600; }
    .bar-container { background: #e5e7eb; border-radius: 4px; height: 8px; margin-top: 4px; }
    .bar-fill { height: 8px; border-radius: 4px; }
    .bar-green { background: #10b981; }
    .bar-yellow { background: #f59e0b; }
    .bar-red { background: #ef4444; }
    .alert-row { background: #fef2f2; padding: 12px; border-radius: 6px; margin-bottom: 8px; }
    .alert-row.warning { background: #fffbeb; }
    .bill-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f3f4f6; font-size: 14px; }
    .bill-date { color: #6b7280; font-size: 12px; }
    .footer { padding: 24px; text-align: center; background: #f9fafb; }
    .footer p { color: #9ca3af; font-size: 12px; margin: 0; }
    .net-worth-bar { display: flex; height: 12px; border-radius: 6px; overflow: hidden; margin: 8px 0; }
    .assets-bar { background: #10b981; }
    .liabilities-bar { background: #ef4444; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; }
    .badge-danger { background: #fee2e2; color: #dc2626; }
    .badge-warning { background: #fef3c7; color: #d97706; }
  </style>
</head>
<body>
  <div style="padding: 20px;">
    <div class="container">
      <!-- Header -->
      <div class="header">
        <h1>📊 Weekly Financial Digest</h1>
        <p><%= @period_start %> — <%= @period_end %></p>
      </div>

      <!-- Overview Stats -->
      <div class="section">
        <div class="stat-grid">
          <div class="stat-card">
            <div class="stat-value red">$<%= format_cents(@data[:spending][:total_cents]) %></div>
            <div class="stat-label">Spent</div>
          </div>
          <div class="stat-card">
            <div class="stat-value green">$<%= format_cents(@data[:income][:total_cents]) %></div>
            <div class="stat-label">Income</div>
          </div>
          <div class="stat-card">
            <div class="stat-value"><%= @data[:transaction_count] %></div>
            <div class="stat-label">Transactions</div>
          </div>
        </div>
      </div>

      <!-- Top Spending Categories -->
      <% if @data[:top_categories].any? %>
        <div class="section">
          <div class="section-title">Top Spending Categories</div>
          <table>
            <% max = @data[:top_categories].first[:amount_cents].to_f %>
            <% @data[:top_categories].each do |cat| %>
              <tr>
                <td>
                  <%= cat[:name] %>
                  <div class="bar-container">
                    <div class="bar-fill bar-green" style="width: <%= [(cat[:amount_cents] / max * 100).round, 100].min %>%"></div>
                  </div>
                </td>
                <td>$<%= format_cents(cat[:amount_cents]) %></td>
              </tr>
            <% end %>
          </table>
        </div>
      <% end %>

      <!-- Top Merchants -->
      <% if @data[:top_merchants].any? %>
        <div class="section">
          <div class="section-title">Top Merchants</div>
          <table>
            <% @data[:top_merchants].each do |m| %>
              <tr>
                <td><%= m[:name] %></td>
                <td>$<%= format_cents(m[:amount_cents]) %></td>
              </tr>
            <% end %>
          </table>
        </div>
      <% end %>

      <!-- Budget Alerts -->
      <% if @data[:budget_alerts].any? %>
        <div class="section">
          <div class="section-title">⚠️ Budget Alerts</div>
          <% @data[:budget_alerts].each do |alert| %>
            <div class="alert-row <%= alert[:percentage] >= 100 ? '' : 'warning' %>">
              <strong><%= alert[:category] %></strong>
              <span class="badge <%= alert[:percentage] >= 100 ? 'badge-danger' : 'badge-warning' %>">
                <%= alert[:percentage] %>%
              </span>
              <br>
              <span style="font-size: 13px; color: #6b7280;">
                $<%= format_cents(alert[:spent_cents]) %> of $<%= format_cents(alert[:budgeted_cents]) %> budget
              </span>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Upcoming Bills -->
      <% if @data[:upcoming_bills].any? %>
        <div class="section">
          <div class="section-title">📅 Upcoming Bills</div>
          <% @data[:upcoming_bills].each do |bill| %>
            <div class="bill-row">
              <div>
                <strong><%= bill[:name] %></strong>
                <div class="bill-date">Due <%= bill[:due_date]&.strftime('%b %d') %></div>
              </div>
              <div style="font-weight: 600;">$<%= format_cents(bill[:amount_cents]) %></div>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Net Worth -->
      <% nw = @data[:net_worth] %>
      <% if nw[:assets_cents] > 0 || nw[:liabilities_cents] > 0 %>
        <div class="section">
          <div class="section-title">Net Worth</div>
          <div class="stat-grid">
            <div class="stat-card">
              <div class="stat-value" style="font-size: 28px; color: <%= nw[:net_worth_cents] >= 0 ? '#059669' : '#dc2626' %>;">
                $<%= format_cents(nw[:net_worth_cents].abs) %>
              </div>
              <div class="stat-label"><%= nw[:net_worth_cents] >= 0 ? 'Net Worth' : 'Net Debt' %></div>
            </div>
          </div>
          <% total = nw[:assets_cents] + nw[:liabilities_cents] %>
          <% if total > 0 %>
            <div class="net-worth-bar">
              <div class="assets-bar" style="width: <%= (nw[:assets_cents].to_f / total * 100).round %>%"></div>
              <div class="liabilities-bar" style="width: <%= (nw[:liabilities_cents].to_f / total * 100).round %>%"></div>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 12px; color: #6b7280;">
              <span>🟢 Assets: $<%= format_cents(nw[:assets_cents]) %></span>
              <span>🔴 Liabilities: $<%= format_cents(nw[:liabilities_cents]) %></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Needs Review -->
      <% if @data[:needs_review_count] > 0 %>
        <div class="section" style="text-align: center;">
          <p style="color: #6b7280; font-size: 14px;">
            You have <strong><%= @data[:needs_review_count] %></strong> transaction<%= @data[:needs_review_count] == 1 ? '' : 's' %> that need<%= @data[:needs_review_count] == 1 ? 's' : '' %> review.
          </p>
        </div>
      <% end %>

      <!-- Footer -->
      <div class="footer">
        <p>OpenFinance — Your finances, your data.</p>
        <p style="margin-top: 8px;">To change digest frequency, visit Settings → Notifications.</p>
      </div>
    </div>
  </div>
</body>
</html>
