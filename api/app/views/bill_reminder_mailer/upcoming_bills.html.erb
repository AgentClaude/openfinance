<% @header_subtitle = "#{@bills.size} bill#{@bills.size == 1 ? '' : 's'} due soon" %>

<h2 style="font-size: 18px; color: #18181b; margin: 0 0 16px;">Upcoming Bills 📋</h2>

<p style="color: #52525b; margin: 0 0 20px;">You have <strong><%= @bills.size %></strong> bill<%= @bills.size == 1 ? '' : 's' %> due in the next 3 days totaling <strong style="color: #dc2626;">$<%= '%.2f' % @total %></strong>.</p>

<table style="width: 100%;">
  <thead>
    <tr>
      <th style="font-size: 11px; color: #71717a; font-weight: 500; text-transform: uppercase; text-align: left; padding: 8px 12px; border-bottom: 2px solid #e4e4e7;">Bill</th>
      <th style="font-size: 11px; color: #71717a; font-weight: 500; text-transform: uppercase; text-align: center; padding: 8px 12px; border-bottom: 2px solid #e4e4e7;">Due</th>
      <th style="font-size: 11px; color: #71717a; font-weight: 500; text-transform: uppercase; text-align: right; padding: 8px 12px; border-bottom: 2px solid #e4e4e7;">Amount</th>
    </tr>
  </thead>
  <tbody>
    <% @bills.each do |bill| %>
      <tr>
        <td style="padding: 12px; border-bottom: 1px solid #f4f4f5; font-size: 14px; color: #18181b;"><%= bill.name %></td>
        <td style="padding: 12px; border-bottom: 1px solid #f4f4f5; font-size: 13px; text-align: center;">
          <% if bill.next_occurrence <= Date.current %>
            <span style="color: #dc2626; font-weight: 500;">Today</span>
          <% elsif bill.next_occurrence == Date.tomorrow %>
            <span style="color: #ca8a04; font-weight: 500;">Tomorrow</span>
          <% else %>
            <span style="color: #52525b;"><%= bill.next_occurrence.strftime('%b %d') %></span>
          <% end %>
        </td>
        <td style="padding: 12px; border-bottom: 1px solid #f4f4f5; font-size: 14px; color: #18181b; text-align: right; font-weight: 500;">$<%= '%.2f' % (bill.amount_cents.abs / 100.0) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="2" style="padding: 12px; font-size: 14px; font-weight: 600; color: #18181b;">Total</td>
      <td style="padding: 12px; font-size: 14px; font-weight: 700; color: #dc2626; text-align: right;">$<%= '%.2f' % @total %></td>
    </tr>
  </tfoot>
</table>

<div style="text-align: center; margin-top: 24px;">
  <a href="#" class="btn">View Recurring Bills →</a>
</div>
