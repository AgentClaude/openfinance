<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f4f4f7; margin: 0; padding: 20px; color: #333; }
    .container { max-width: 500px; margin: 0 auto; background: #fff; border-radius: 8px; overflow: hidden; }
    .header { background: <%= @notification.priority == 'high' ? '#dc2626' : '#3b82f6' %>; padding: 24px; }
    .header h1 { color: #fff; margin: 0; font-size: 18px; }
    .body { padding: 24px; }
    .body p { line-height: 1.6; margin: 0 0 16px; }
    .footer { padding: 16px 24px; background: #f9fafb; text-align: center; }
    .footer p { color: #9ca3af; font-size: 12px; margin: 0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1><%= @notification.title %></h1>
    </div>
    <div class="body">
      <% if @notification.body.present? %>
        <p><%= @notification.body %></p>
      <% end %>
      <p style="color: #9ca3af; font-size: 12px;"><%= @notification.created_at.strftime('%B %d, %Y at %I:%M %p') %></p>
    </div>
    <div class="footer">
      <p>OpenFinance — Your finances, your data.</p>
    </div>
  </div>
</body>
</html>
