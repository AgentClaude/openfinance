<div style="max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1a1a2e;">
  <div style="background: linear-gradient(135deg, #f59e0b, #d97706); padding: 24px 32px; border-radius: 12px 12px 0 0;">
    <h1 style="color: #fff; margin: 0; font-size: 20px;">📅 Upcoming Bills</h1>
    <p style="color: #fef3c7; margin: 8px 0 0; font-size: 14px;">
      <%= @items.size %> bill<%= @items.size == 1 ? '' : 's' %> due soon — Total: <%= number_to_currency(@total) %>
    </p>
  </div>

  <div style="background: #fff; padding: 32px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 12px 12px;">
    <p style="color: #6b7280; font-size: 15px; margin: 0 0 24px;">
      Hi <%= @user.name.present? ? @user.name.split(' ').first : 'there' %>,
      here are your upcoming bills for the next few days.
    </p>

    <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
      <thead>
        <tr style="border-bottom: 2px solid #e5e7eb;">
          <th style="text-align: left; padding: 8px 0; font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em;">Bill</th>
          <th style="text-align: right; padding: 8px 0; font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em;">Amount</th>
          <th style="text-align: right; padding: 8px 0; font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em;">Due</th>
        </tr>
      </thead>
      <tbody>
        <% @items.each do |item| %>
        <tr style="border-bottom: 1px solid #f3f4f6;">
          <td style="padding: 12px 0; font-size: 14px; color: #374151; font-weight: 500;">
            <%= item.name %>
            <% if item.category %>
              <br><span style="font-size: 12px; color: #9ca3af;"><%= item.category.name %></span>
            <% end %>
          </td>
          <td style="padding: 12px 0; text-align: right; font-size: 14px; font-weight: 600; color: #1a1a2e;">
            <%= number_to_currency(item.amount_cents.abs / 100.0) %>
          </td>
          <td style="padding: 12px 0; text-align: right; font-size: 13px; color: <%= item.next_occurrence && item.next_occurrence <= Date.current ? '#dc2626' : '#6b7280' %>;">
            <%= item.next_occurrence&.strftime('%b %d') || 'N/A' %>
          </td>
        </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr style="border-top: 2px solid #e5e7eb;">
          <td style="padding: 12px 0; font-size: 14px; font-weight: 700;">Total</td>
          <td style="padding: 12px 0; text-align: right; font-size: 16px; font-weight: 700; color: #1a1a2e;">
            <%= number_to_currency(@total) %>
          </td>
          <td></td>
        </tr>
      </tfoot>
    </table>

    <a href="<%= app_url %>" style="display: inline-block; background: #6366f1; color: #fff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 600; font-size: 14px;">
      View Recurring Bills →
    </a>
  </div>

  <p style="text-align: center; color: #9ca3af; font-size: 12px; margin-top: 24px;">
    You received this because bill reminders are enabled in your OpenFinance settings.
  </p>
</div>
