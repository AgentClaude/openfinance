<div style="max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1a1a2e;">
  <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 24px; border-radius: 12px 12px 0 0;">
    <h1 style="color: white; margin: 0; font-size: 20px;">💰 Large Transaction</h1>
  </div>
  <div style="background: #ffffff; padding: 24px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 12px 12px;">
    <div style="background: #fefce8; border: 1px solid #fde68a; border-radius: 8px; padding: 16px; margin: 16px 0;">
      <table style="width: 100%; border-collapse: collapse;">
        <tr>
          <td style="padding: 8px 0; color: #6b7280;">Amount</td>
          <td style="padding: 8px 0; text-align: right; font-weight: 700; font-size: 20px; color: #1a1a2e;">$<%= '%.2f' % @amount %></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; color: #6b7280;">Merchant</td>
          <td style="padding: 8px 0; text-align: right; font-weight: 600; color: #1a1a2e;"><%= @merchant %></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; color: #6b7280;">Account</td>
          <td style="padding: 8px 0; text-align: right; color: #6b7280;"><%= @account %></td>
        </tr>
      </table>
    </div>
    <p style="color: #4a5568; line-height: 1.6;">A large transaction was detected on your account. If this doesn't look right, review it in OpenFinance.</p>
    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 20px 0;">
    <p style="color: #9ca3af; font-size: 12px;">Manage transaction alerts in Settings → Notifications.</p>
  </div>
</div>
