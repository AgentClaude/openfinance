<div style="max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1a1a2e;">
  <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 24px; border-radius: 12px 12px 0 0;">
    <h1 style="color: white; margin: 0; font-size: 20px;">📅 Upcoming Bill</h1>
  </div>
  <div style="background: #ffffff; padding: 24px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 12px 12px;">
    <h2 style="margin-top: 0; color: #1a1a2e;"><%= @item.name %></h2>

    <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 16px; margin: 16px 0;">
      <table style="width: 100%; border-collapse: collapse;">
        <tr>
          <td style="padding: 8px 0; color: #6b7280;">Amount</td>
          <td style="padding: 8px 0; text-align: right; font-weight: 600; color: #1a1a2e;">$<%= '%.2f' % @amount %></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; color: #6b7280;">Due Date</td>
          <td style="padding: 8px 0; text-align: right; font-weight: 600; color: #1a1a2e;"><%= @due_date.strftime('%B %d, %Y') %></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; color: #6b7280;">Frequency</td>
          <td style="padding: 8px 0; text-align: right; color: #6b7280;"><%= @item.frequency.capitalize %></td>
        </tr>
      </table>
    </div>

    <p style="color: #4a5568; line-height: 1.6;">
      <% days_until = (@due_date.to_date - Date.current).to_i %>
      <% if days_until == 0 %>
        This bill is <strong>due today</strong>.
      <% elsif days_until == 1 %>
        This bill is due <strong>tomorrow</strong>.
      <% else %>
        This bill is due in <strong><%= days_until %> days</strong>.
      <% end %>
    </p>

    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 20px 0;">
    <p style="color: #9ca3af; font-size: 12px;">Manage bill reminders in Settings → Notifications.</p>
  </div>
</div>
