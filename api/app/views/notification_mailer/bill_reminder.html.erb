<div style="max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1f2937;">
  <div style="background: #0f172a; padding: 24px; border-radius: 8px 8px 0 0;">
    <h1 style="color: #ffffff; margin: 0; font-size: 20px;">💰 OpenFinance</h1>
  </div>

  <div style="padding: 24px; background: #ffffff; border: 1px solid #e5e7eb; border-top: none;">
    <h2 style="margin: 0 0 8px; font-size: 18px; color: #1f2937;">
      <%= @notification.title %>
    </h2>

    <p style="color: #6b7280; font-size: 14px; margin: 0 0 20px;">
      <%= @notification.body %>
    </p>

    <% if @recurring_item %>
      <div style="background: #f9fafb; border-radius: 8px; padding: 16px; margin-bottom: 20px;">
        <table style="width: 100%; font-size: 14px; border-collapse: collapse;">
          <tr>
            <td style="padding: 4px 0; color: #6b7280;">Amount</td>
            <td style="padding: 4px 0; text-align: right; font-weight: 600;">$<%= '%.2f' % @recurring_item.amount %></td>
          </tr>
          <tr>
            <td style="padding: 4px 0; color: #6b7280;">Frequency</td>
            <td style="padding: 4px 0; text-align: right;"><%= @recurring_item.frequency.capitalize %></td>
          </tr>
          <tr>
            <td style="padding: 4px 0; color: #6b7280;">Due Date</td>
            <td style="padding: 4px 0; text-align: right;"><%= @recurring_item.next_occurrence&.strftime('%B %d, %Y') %></td>
          </tr>
          <% if @recurring_item.category %>
            <tr>
              <td style="padding: 4px 0; color: #6b7280;">Category</td>
              <td style="padding: 4px 0; text-align: right;"><%= @recurring_item.category.name %></td>
            </tr>
          <% end %>
        </table>
      </div>
    <% end %>

    <a href="<%= root_url %>recurring" style="display: inline-block; background: #3b82f6; color: #ffffff; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500;">
      View Recurring Bills
    </a>
  </div>

  <div style="padding: 16px 24px; background: #f9fafb; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 8px 8px;">
    <p style="margin: 0; font-size: 12px; color: #9ca3af; text-align: center;">
      You're receiving this because you have bill reminder notifications enabled.
      <a href="<%= root_url %>settings" style="color: #3b82f6;">Manage preferences</a>
    </p>
  </div>
</div>
