<div style="max-width: 600px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #1a1a2e;">
  <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 24px; border-radius: 12px 12px 0 0;">
    <h1 style="color: white; margin: 0; font-size: 20px;">⚠️ Budget Alert</h1>
  </div>
  <div style="background: #ffffff; padding: 24px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 12px 12px;">
    <h2 style="margin-top: 0; color: #1a1a2e;"><%= @category_name %></h2>

    <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 16px; margin: 16px 0;">
      <table style="width: 100%; border-collapse: collapse;">
        <tr>
          <td style="padding: 8px 0; color: #6b7280;">Spent</td>
          <td style="padding: 8px 0; text-align: right; font-weight: 600; color: #ef4444;">$<%= '%.2f' % @spent %></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; color: #6b7280;">Budget</td>
          <td style="padding: 8px 0; text-align: right; font-weight: 600; color: #1a1a2e;">$<%= '%.2f' % @budgeted %></td>
        </tr>
        <tr>
          <td style="padding: 8px 0; color: #6b7280;">Usage</td>
          <td style="padding: 8px 0; text-align: right; font-weight: 600; color: <%= @percentage > 100 ? '#ef4444' : '#f59e0b' %>;"><%= @percentage.round(0) %>%</td>
        </tr>
      </table>
    </div>

    <!-- Progress bar -->
    <div style="background: #e5e7eb; border-radius: 9999px; height: 8px; overflow: hidden; margin: 16px 0;">
      <div style="background: <%= @percentage > 100 ? '#ef4444' : @percentage > 80 ? '#f59e0b' : '#10b981' %>; height: 100%; width: <%= [@percentage, 100].min %>%; border-radius: 9999px;"></div>
    </div>

    <p style="color: #4a5568; line-height: 1.6;">
      <% if @percentage > 100 %>
        You've exceeded your budget for <strong><%= @category_name %></strong> by $<%= '%.2f' % (@spent - @budgeted) %>.
      <% else %>
        You've used <%= @percentage.round(0) %>% of your <strong><%= @category_name %></strong> budget.
        You have $<%= '%.2f' % (@budgeted - @spent) %> remaining.
      <% end %>
    </p>

    <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 20px 0;">
    <p style="color: #9ca3af; font-size: 12px;">Manage budget alerts in Settings → Notifications.</p>
  </div>
</div>
